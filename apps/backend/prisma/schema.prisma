// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  SPACE_MANAGER
  MEMBER
}

enum BookableType {
  DESK
  ROOM
}

// Stage 6: tracks a booking's Stripe payment lifecycle. Deliberately kept
// on Booking rather than a separate Payment model — a booking has exactly
// one payment attempt in this MVP's scope (no partial payments, no
// multiple attempts modeled), so a separate table would be normalization
// without payoff at this scale. Revisit if that assumption changes.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model Space {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  priceCents Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  zones Zone[]
  users User[]
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desks Desk[]
  rooms Room[]

  @@index([spaceId])
}

model Desk {
  id        String   @id @default(cuid())
  name      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

// Polymorphic booking: bookableId is NOT a formal FK.
// App code resolves bookableId against Desk or Room based on bookableType.
//
// The @@unique constraint prevents duplicate bookings with the same
// resource and start time.
//
// The stronger PostgreSQL EXCLUDE constraint
// "no_overlapping_bookings" is defined in the
// 20260820000000_add_booking_constraints migration and prevents
// overlapping time ranges for the same Desk/Room.
model Booking {
  id           String       @id @default(cuid())
  bookableType BookableType
  bookableId   String
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime     @default(now())

  // Stage 6: snapshot the Space's flat booking price at booking creation.
  // Keeping the amount on Booking means later Space price changes do not
  // alter the historical amount of an existing booking.
  paymentStatus         PaymentStatus @default(UNPAID)
  amountCents           Int?
  stripePaymentIntentId String?       @unique

  // Set only while this booking is "holding" a slot without having
  // actually paid yet (PENDING = payment in progress, or FAILED = a
  // payment attempt was declined but the user hasn't rebooked). Null
  // for UNPAID (no payment needed at all -- not a hold, a completed
  // booking) and for PAID (the hold has been fully honored, no longer
  // temporary). bookings.service.ts deletes any booking past this
  // timestamp before it can block a new booking attempt on the same
  // slot -- same idea as a movie-ticket seat hold expiring.
  holdExpiresAt DateTime?

  @@unique([bookableType, bookableId, startTime])
  @@index([bookableType, bookableId])
  @@index([userId])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  // Nullable rather than required: lets `prisma migrate deploy` apply
  // cleanly against existing seeded rows before `seed.ts` (updated
  // alongside this migration) reseeds them with real bcrypt hashes.
  // AuthService.login() rejects any user with a null password rather
  // than silently allowing passwordless login.
  password  String?
  name      String?
  role      Role
  // Nullable: null for PLATFORM_ADMIN (not scoped to any space),
  // always set for SPACE_MANAGER and MEMBER.
  spaceId   String?
  space     Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Stage 6: only meaningful for SPACE_MANAGER — the Stripe Connect
  // account that receives the 95% split for bookings in their space.
  // Null until they start Connect onboarding (see StripeService's
  // createOrGetConnectAccount).
  stripeAccountId String?
  // Separate from stripeAccountId's presence: an account can exist
  // (stripeAccountId set) but still be mid-onboarding and unable to
  // receive transfers. This flips true only once Stripe's
  // `account.updated` webhook confirms charges_enabled + details_submitted
  // — see webhook.controller.ts. Added this session alongside the
  // onboarding flow itself; flagged as a real schema change, not silent.
  stripeOnboardingComplete Boolean @default(false)

  bookings Booking[]

  @@index([spaceId])
}
