// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  SPACE_MANAGER
  MEMBER
}

enum BookableType {
  DESK
  ROOM
}

model Space {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  zones Zone[]
  users User[]
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desks Desk[]
  rooms Room[]

  @@index([spaceId])
}

model Desk {
  id        String   @id @default(cuid())
  name      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

// Polymorphic booking: bookableId is NOT a formal FK.
// App code resolves bookableId against Desk or Room based on bookableType.
//
// The @@unique constraint prevents duplicate bookings with the same
// resource and start time.
//
// The stronger PostgreSQL EXCLUDE constraint
// "no_overlapping_bookings" is defined in the
// 20260820000000_add_booking_constraints migration and prevents
// overlapping time ranges for the same Desk/Room.
model Booking {
  id           String       @id @default(cuid())
  bookableType BookableType
  bookableId   String
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime     @default(now())

  @@unique([bookableType, bookableId, startTime])
  @@index([bookableType, bookableId])
  @@index([userId])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      Role
  // Nullable: null for PLATFORM_ADMIN (not scoped to any space),
  // always set for SPACE_MANAGER and MEMBER.
  spaceId   String?
  space     Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings Booking[]

  @@index([spaceId])
}
