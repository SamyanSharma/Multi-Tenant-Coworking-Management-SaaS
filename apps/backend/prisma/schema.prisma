// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLATFORM_ADMIN
  SPACE_MANAGER
  MEMBER
}

enum BookableType {
  DESK
  ROOM
}

// Stage 6: tracks a booking's Stripe payment lifecycle. Deliberately kept
// on Booking rather than a separate Payment model — a booking has exactly
// one payment attempt in this MVP's scope (no partial payments, no
// multiple attempts modeled), so a separate table would be normalization
// without payoff at this scale. Revisit if that assumption changes.
enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

model Space {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones Zone[]
  users User[]
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desks Desk[]
  rooms Room[]

  @@index([spaceId])
}

model Desk {
  id        String   @id @default(cuid())
  name      String
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

// Polymorphic booking: bookableId is NOT a formal FK (per ARCHITECTURE.md).
// App code resolves bookableId against Desk or Room based on bookableType.
// @@unique below is the Stage 4 "simple" concurrency guard — see
// prisma/migrations/*_add_booking_overlap_exclusion for the stronger
// range-overlap version discussed alongside it, which is NOT applied by
// default (team decision pending — see PR description / ARCHITECTURE.md).
model Booking {
  id           String       @id @default(cuid())
  bookableType BookableType
  bookableId   String
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime     @default(now())

  // Stage 6 additions — payment tracking. amountCents is set at booking
  // creation time (Stage 6's payments flow reads the desk/room's price;
  // NOTE: no price field exists on Desk/Room yet either — this MVP
  // currently expects amountCents to be passed by the client/frontend
  // until a real pricing model is designed. Flagged, not silently assumed.
  paymentStatus         PaymentStatus @default(UNPAID)
  amountCents           Int?
  stripePaymentIntentId String?       @unique

  @@unique([bookableType, bookableId, startTime])
  @@index([bookableType, bookableId])
  @@index([userId])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      Role
  // Nullable: null for PLATFORM_ADMIN (not scoped to any space),
  // always set for SPACE_MANAGER and MEMBER.
  spaceId   String?
  space     Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Stage 6: only meaningful for SPACE_MANAGER — the Stripe Connect
  // account that receives the 95% split for bookings in their space.
  // Null until they start Connect onboarding (see StripeService's
  // createOrGetConnectAccount).
  stripeAccountId String?
  // Separate from stripeAccountId's presence: an account can exist
  // (stripeAccountId set) but still be mid-onboarding and unable to
  // receive transfers. This flips true only once Stripe's
  // `account.updated` webhook confirms charges_enabled + details_submitted
  // — see webhook.controller.ts. Added this session alongside the
  // onboarding flow itself; flagged as a real schema change, not silent.
  stripeOnboardingComplete Boolean @default(false)

  bookings Booking[]

  @@index([spaceId])
}
