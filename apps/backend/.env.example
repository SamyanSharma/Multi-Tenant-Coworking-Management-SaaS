# Copy to apps/backend/.env and fill in. Never commit the real .env.

# PostgreSQL (docker-compose.yml at the repo root starts one with these defaults)
DATABASE_URL=postgresql://coworking:coworking_dev_pw@localhost:5432/coworking_dev

# Separate database used ONLY by `npm run test:e2e` (the e2e specs create and
# delete rows). Create it once, then apply migrations to it.
TEST_DATABASE_URL=postgresql://coworking:coworking_dev_pw@localhost:5432/coworking_test

PORT=3000
FRONTEND_URL=http://localhost:3001

# Signs login tokens. REQUIRED in production (the app refuses to boot with the
# dev fallback there). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me

# Stripe TEST-mode keys only (the app rejects anything that is not sk_test_).
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Number of reverse-proxy hops in front of the API when deployed (Render,
# Railway, nginx...). Needed so rate limiting sees real client IPs. Leave
# unset when running locally.
# TRUST_PROXY=1
